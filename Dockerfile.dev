FROM node:24-bookworm AS base

WORKDIR /app

RUN corepack enable

# Next.js collects completely anonymous telemetry data about general usage. Learn more here: https://nextjs.org/telemetry
# Uncomment the following line to disable telemetry at run time
ENV NEXT_TELEMETRY_DISABLED=1

# Unit tests install deps into a volume at run time (docker-compose.testunit.yml), so this
# stage skips them and a package.json change never rebuilds it. The empty node_modules makes
# a fresh volume start owned by node, which the corepack cache inside it needs.
FROM base AS test-runner
RUN mkdir -p /app/node_modules && chown -R node:node /app
USER node

# Playwright e2e runner (docker-compose.e2e.yml, bin/docker-e2e). Only this stage carries Chromium,
# so the dev and unit-test images never grow or rebuild because of e2e.
FROM base AS e2e-runner
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client && rm -rf /var/lib/apt/lists/*
# Outside the repo pnpm sees neither the pinned packageManager nor pnpm-workspace.yaml, so it would
# install with another pnpm and without minimumReleaseAge. The browser installs run here instead.
WORKDIR /opt/pnpm-rules
COPY pnpm-workspace.yaml ./
ARG PNPM_PACKAGE_MANAGER
RUN test -n "$PNPM_PACKAGE_MANAGER" \
    && printf '{"private":true,"packageManager":"%s"}\n' "$PNPM_PACKAGE_MANAGER" > package.json \
    && echo "pnpm $(pnpm --version), minimumReleaseAge $(pnpm config get minimumReleaseAge)"
# Keyed on the locked version, so every run and every checkout reuses this layer.
ARG PLAYWRIGHT_VERSION
RUN test -n "$PLAYWRIGHT_VERSION" \
    && pnpm dlx "playwright@${PLAYWRIGHT_VERSION}" install --with-deps chromium \
    && rm -rf /root/.cache/pnpm /root/.local/share/pnpm
WORKDIR /app
RUN mkdir -p /app/node_modules /app/.next && chown -R node:node /app
USER node

FROM base AS dev

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

RUN pnpm install --frozen-lockfile

#COPY .gitignore .editorconfig next.config.mjs tsconfig.json kysely.config.ts .eslintrc.json .prettierrc.json .

# Pre-create .next so the anonymous volume masking it (see docker-compose.yml)
# initializes owned by node, not root — otherwise next dev hits EACCES on mkdir.
RUN mkdir -p /app/.next

# do not run as root user
RUN chown -R node:node /app
USER node

# for deploying the build version

# RUN bun next build
# and
# CMD bun next start

# OR starting Next.js in development, comment above two lines and uncomment below line

CMD ["./bin/docker-dev-init"]
