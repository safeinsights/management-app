// A parameterized job for the deployed-environment e2e suite, for the release pipeline to trigger
// after each environment's deploy (smoke on production and demo, smoke plus full on staging), and
// for QA to run on demand against any target. Point a Jenkins pipeline job at this file.
pipeline {
    agent { label "jenkins" }

    parameters {
        choice(name: 'E2E_TARGET', choices: ['qa', 'staging', 'demo', 'production'], description: 'Environment, or type a PR preview as pr<number> in E2E_TARGET_OVERRIDE')
        string(name: 'E2E_TARGET_OVERRIDE', defaultValue: '', description: 'pr<number> for a PR preview; empty uses E2E_TARGET')
        choice(name: 'E2E_PROJECT', choices: ['smoke', 'full'], description: 'smoke is safe everywhere; full creates studies and waits for the enclave')
        string(name: 'E2E_EXPECTED_RELEASE', defaultValue: '', description: 'The tag or short SHA the about page must show')
    }

    options { timeout(time: 120, unit: 'MINUTES') }

    stages {
        stage("Deployed e2e") {
            steps {
                withCredentials([file(credentialsId: 'mgmt-app-e2e-deployed-env', variable: 'E2E_DEPLOYED_ENV_FILE')]) {
                    sh """
                        corepack enable
                        pnpm install --frozen-lockfile
                        pnpm exec playwright install --with-deps --only-shell chromium
                        TARGET="\${E2E_TARGET_OVERRIDE:-\$E2E_TARGET}"
                        E2E_EXPECTED_RELEASE="\$E2E_EXPECTED_RELEASE" ./bin/e2e-deployed --target "\$TARGET" --project "\$E2E_PROJECT"
                    """
                }
            }
            post {
                always {
                    junit testResults: 'test-results/deployed/junit.xml', allowEmptyResults: true
                    archiveArtifacts artifacts: 'test-results/deployed/**, test-results/deployed-html/**', allowEmptyArchive: true
                }
            }
        }
    }
}
