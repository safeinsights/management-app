#!/usr/bin/env bash
#
# Main-compatible local wrapper for the Playwright-owned app server. Docker e2e uses
# bin/docker-e2e-app instead so local environment changes cannot redirect its app.
#
# Usage: ./bin/app-test [--no-build]   (--no-build reuses an existing .next build)
#
# Driven by playwright.config.ts `webServer`. Local dev (port 4000) remains untouched.

set -euo pipefail

cd "$(dirname "$0")/.."

# Keep the same optional environment loading and fixed app port as main.
if [ -f .env.test ]; then
    set -a
    # shellcheck disable=SC1091
    . ./.env.test
    set +a
fi

export PORT=4100
exec ./bin/e2e-app-server "$@"
