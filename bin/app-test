#!/usr/bin/env bash
#
# Usage: ./bin/app-test [--no-build]   (--no-build reuses an existing .next build)
#
# Build once and serve Next.js's standalone output for Playwright. Local mode retains main's
# .env.test behavior and port 4100. Docker mode inherits its authoritative environment and
# port 4101 without reloading local configuration. Local development on port 4000 is untouched.

set -euo pipefail

cd "$(dirname "$0")/.."

if [ "${E2E_MODE:-}" = "docker" ]; then
    : "${DATABASE_URL:?docker-e2e environment was not initialized}"
    : "${S3_ENDPOINT:?docker-e2e environment was not initialized}"
    : "${PORT:?docker-e2e environment was not initialized}"
else
    # Keep the same optional environment loading and fixed app port as main.
    if [ -f .env.test ]; then
        set -a
        # shellcheck disable=SC1091
        . ./.env.test
        set +a
    fi
    export PORT=4100
fi

export CI=true
export E2E_FAKE_CLERK=1
export SINGLE_USER_EDITING=t
export ASSETS_PREFIX=/
export CODER_FILES=./coder-files
unset AWS_PROFILE
export NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="${NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY:-pk_test_ZHVtbXktZm9yLWUyZS5jbGVyay5hY2NvdW50cy5kZXYk}"

if [ "${1:-}" != "--no-build" ]; then
    echo "app-test: building (E2E_FAKE_CLERK=1)..."
    if [ "${E2E_MODE:-}" = "docker" ]; then
        # The binary directly, not `pnpm exec`: the app container does not provision corepack the
        # way the seed container does, so going through pnpm would try to fetch it over the network
        # mid-build. Do not "tidy" this back to `pnpm exec` without giving that container a
        # COREPACK_HOME on the node_modules volume.
        ./node_modules/.bin/next build
    else
        pnpm exec next build
    fi
fi

cp -r public .next/standalone/ 2>/dev/null || true
mkdir -p .next/standalone/coder-files
cp -r .next/static .next/standalone/.next/ 2>/dev/null || true

echo "app-test: starting standalone server on :${PORT} (CI=true, E2E_FAKE_CLERK=1, SINGLE_USER_EDITING=t)"
exec node .next/standalone/server.js
