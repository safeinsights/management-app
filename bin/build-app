#!/usr/bin/env bash
set -euo pipefail

# https://github.com/getsentry/sentry-javascript/issues/15100
# workaround for build spewing thousands of lines of:
# <w> [webpack.cache.PackFileCacheStrategy] Serializing big strings (135kiB) impacts deserialization performance ...
#
# `next` is invoked directly via node_modules/.bin rather than through `pnpm run build`: the
# deploy already reaches this script as `pnpm run build:app` (it enables corepack, runs
# `pnpm install --frozen-lockfile`, then the package script), so another pnpm hop would only
# add a process. Either form works.
./node_modules/.bin/next build 2>&1 | stdbuf -oL grep -v 'PackFileCacheStrategy'

cp bin/prod.run.sh .next/standalone/run.sh

# The review worker Lambda (OTTER-799) deploys this same zip with its own handler, so its bundle
# rides along at the root. @sentry/nextjs is aliased to @sentry/node because the Next build of the
# SDK is webpack-only. .cjs because the standalone package.json says "type": "module".
./node_modules/.bin/esbuild src/server/agents/review-agent/worker.ts \
    --bundle --platform=node --target=node22 --format=cjs \
    --outfile=.next/standalone/review-worker.cjs \
    --alias:@sentry/nextjs=@sentry/node --external:pg-native \
    --tsconfig=tsconfig.json --sourcemap=linked --log-level=warning

# -y preserves symlinks instead of following them. Next's standalone output
# under pnpm keeps node_modules/next (and other deps) as symlinks into the
# .pnpm store; their transitive deps (@next/env, @swc/helpers, …) only resolve
# through that symlink graph. Without -y, zip dereferences node_modules/next
# into real files but strands its .pnpm-nested deps, so the Lambda fails at
# startup with `Cannot find module '@next/env'` / '@swc/helpers'. Preserving the
# symlinks keeps the graph intact end to end.
pushd .next/standalone/
zip -q -r -y ../../lambda-server-package.zip .
popd
