#!/usr/bin/env bash
set -euo pipefail

# `./bin/docker-e2e` entrypoint: run the e2e suite with Postgres + SeaweedFS provided by
# Docker (docker-compose.e2e.yml). The counterpart is ./bin/local-e2e, for infra you run on
# the host yourself. Pick whichever matches your setup; both then run the same host
# Playwright, so interactive debugging works either way:
#
#   ./bin/docker-e2e                 # full suite (headless)
#   ./bin/docker-e2e -- --ui         # Playwright UI (interactive)
#   ./bin/docker-e2e -- --headed     # watch the browser
#   ./bin/docker-e2e -- study-flow   # subset (any playwright args after --)
#
# Migrates + seeds the isolated test database INSIDE Docker, so no host psql/kysely is
# needed. The app under test is served on the host (port 4101 by default) by Playwright's
# webServer config (bin/docker-e2e-app); it connects to the published test-DB / S3 ports.
#
# Named for its infra, like ./bin/docker-test (unit tests in Docker) and ./bin/local-seaweedfs.
#
# Isolation: a dedicated Postgres container (si_test) with its own volume; the dev DB
# (mgmnt_dev) is never touched.

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
cd "$repo_root"

# This script is a developer entrypoint only (CI runs `pnpm run test:e2e` instead), so a CI
# variable inherited from the caller's shell is always wrong here. It would set IS_CI
# (tests/common.helpers.ts), and playwright.config.ts then uses `webServer: []` — nothing would
# ever serve the app and every spec would fail against a dead port. It also swaps the local
# timeouts for the slower CI ones. The app process still receives CI=true from e2e-app-server.
unset CI

# The public bin/docker-e2e wrapper has already loaded .env + .env.test and then applied the
# authoritative Docker database, S3, auth, and port values. Compose, Playwright, and the app
# server all inherit that same environment.
: "${DATABASE_URL:?docker-e2e environment was not initialized}"
: "${S3_ENDPOINT:?docker-e2e environment was not initialized}"
: "${E2E_BASE_URL:?docker-e2e environment was not initialized}"

COMPOSE_FILE="$repo_root/docker-compose.e2e.yml"
# Fixed project name (single local e2e stack): this stack publishes host ports, so unlike
# bin/docker-test it can't run several copies in parallel anyway.
export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-mgmt-app-e2e-local}"

usage() {
    cat <<EOF
Usage: ./bin/docker-e2e [--clean | --down | --prune] [-- <playwright-args>]

Bring up the dockerized e2e infra + seed, then run Playwright on the host.

Options:
  --clean               Fresh test DB + object storage (KEEP node_modules / pnpm store). Reseeds.
  --down                Stop + remove the e2e containers + network, KEEP volumes. Then exit.
  --prune               Stop + remove EVERYTHING for this stack incl. volumes (deps, DB). Then exit.
  --print-project-name  Print the Compose project name and exit.
  --print-environment   Print non-secret Docker e2e endpoints and exit.
  --help                Show this help.

Examples:
  ./bin/docker-e2e                       # full suite (headless)
  ./bin/docker-e2e -- --ui               # interactive Playwright UI
  ./bin/docker-e2e -- --headed           # watch the browser
  ./bin/docker-e2e -- tests/signin.spec.ts
EOF
    exit 0
}

clean=false
down=false
prune=false
pw_args=()

while [[ $# -gt 0 ]]; do
    case $1 in
        --clean) clean=true; shift ;;
        --down) down=true; shift ;;
        --prune) prune=true; shift ;;
        --print-project-name) echo "$COMPOSE_PROJECT_NAME"; exit 0 ;;
        --print-environment)
            echo "mode=${E2E_MODE}"
            echo "app=${E2E_BASE_URL}"
            echo "postgres=127.0.0.1:${E2E_PG_PORT}/si_test"
            echo "s3=${S3_ENDPOINT}"
            echo "bucket=${BUCKET_NAME}"
            exit 0
            ;;
        --help | -h) usage ;;
        --) shift; pw_args=("$@"); break ;;
        *) echo "Unknown option: $1" >&2; usage ;;
    esac
done

if ! command -v docker >/dev/null 2>&1; then
    echo "ERROR: docker is required (the e2e DB + S3 run via docker compose)." >&2
    exit 1
fi

dc() { docker compose -f "$COMPOSE_FILE" "$@"; }

if [ "$down" = true ]; then
    echo "Stopping e2e containers + network (volumes kept)…"
    dc down --remove-orphans
    exit 0
fi

if [ "$prune" = true ]; then
    echo "Pruning ALL e2e Docker resources for this stack…"
    dc down -v --remove-orphans
    leftover=$(docker volume ls -q --filter "name=^${COMPOSE_PROJECT_NAME}_" 2>/dev/null || true)
    if [ -n "$leftover" ]; then
        echo "$leftover" | xargs docker volume rm >/dev/null 2>&1 || true
    fi
    exit 0
fi

if [ "$clean" = true ]; then
    echo "Cleaning test DB + object storage (deps preserved)…"
    dc down
    docker volume rm "${COMPOSE_PROJECT_NAME}_pgdata-e2e" "${COMPOSE_PROJECT_NAME}_seaweedfs-data-e2e" 2>/dev/null || true
else
    # Auto-detect a migration mismatch: an applied migration no longer in the codebase means
    # the seeded DB is stale (e.g. after a branch switch), so rebuild just the DB volume.
    dc up -d db-e2e --wait 2>/dev/null || true
    applied=$(dc exec -T db-e2e psql -U si -d si_test -t -c "SELECT name FROM kysely_migration" 2>/dev/null | tr -d ' ' | grep -v '^$' || echo "")
    filesystem=$(ls src/database/migrations/*.ts 2>/dev/null | xargs -n1 basename | sed 's/\.ts$//')
    for migration in $applied; do
        if [ -n "$migration" ] && ! echo "$filesystem" | grep -qx "$migration"; then
            echo "Migration mismatch ('$migration' applied but not in codebase) — rebuilding test DB…"
            dc rm -f -s db-e2e 2>/dev/null || true
            docker volume rm "${COMPOSE_PROJECT_NAME}_pgdata-e2e" 2>/dev/null || true
            break
        fi
    done
fi

echo "Starting e2e infra (Postgres + SeaweedFS)…"
dc up -d --wait db-e2e seaweedfs-e2e
dc run --rm create-buckets-e2e

echo "Migrating + seeding the test DB (in Docker)…"
dc run --rm seed-e2e

echo "Running Playwright on the host against the e2e stack…"
if [ ${#pw_args[@]} -gt 0 ]; then
    exec pnpm exec playwright test "${pw_args[@]}"
else
    exec pnpm exec playwright test
fi
