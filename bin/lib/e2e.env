# Shared by the e2e services (env_file) and the host env file of ./bin/docker-e2e --up --host, so
# the container and host Playwright always use the same bucket, credentials and test switches.
# Plain KEY=value lines only: Compose parses this file and bash sources it.
AWS_ACCESS_KEY_ID=si-local-s3
AWS_SECRET_ACCESS_KEY=si-local-s3
BUCKET_NAME=mgmt-app-local
AWS_REGION=us-east-1
E2E_FAKE_CLERK=1
E2E_CI_TIMEOUTS=1

# Set to "" so a .env / .env.test cannot reach real services: dotenv and Next skip keys that are set.
# Never blank a required key (MAILGUN_DOMAIN, CODER_*): getConfigValue would return "".
AWS_PROFILE=
DB_SECRET_ARN=
SECRETS_ARN=
CLAUDE_API_KEY=
MAILGUN_API_KEY=
CLERK_SECRET_KEY=
POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
