# Set to "" in the e2e container and the host env file: dotenv and Next skip keys that are set, so a
# .env / .env.test cannot reach real services. Never blank a required key (MAILGUN_DOMAIN, CODER_*):
# getConfigValue would return "".
AWS_PROFILE=
DB_SECRET_ARN=
SECRETS_ARN=
CLAUDE_API_KEY=
MAILGUN_API_KEY=
CLERK_SECRET_KEY=
POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
