# Keys that ./bin/docker-e2e sets to "" in the container (docker-compose.e2e.yml env_file) and in
# the host env file of --up --host. Next's env loader and dotenv skip keys that are already set,
# even to "", so a bind-mounted or host .env / .env.test cannot reach real services. Every reader
# treats "" as unset; never blank a required key (MAILGUN_DOMAIN, CODER_*), getConfigValue would
# return "".
AWS_PROFILE=
DB_SECRET_ARN=
SECRETS_ARN=
CLAUDE_API_KEY=
MAILGUN_API_KEY=
CLERK_SECRET_KEY=
POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
