#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
cd "$repo_root"

# These can affect pnpm or its AWS-backed dependencies before the TypeScript loader gets a
# chance to build the authoritative Docker environment.
unset CI AWS_PROFILE

exec pnpm exec tsx bin/docker-e2e-environment.ts ./bin/docker-e2e-run "$@"
