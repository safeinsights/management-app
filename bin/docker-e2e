#!/usr/bin/env bash
set -euo pipefail

# Resolve the canonical repo root, following symlinks, so a clone reached via a symlink and one
# reached directly map to the same project (same algorithm as bin/docker-test).
repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
cd "$repo_root"

sha256_hex() {
    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 | cut -d' ' -f1
    elif command -v sha256sum >/dev/null 2>&1; then
        sha256sum | cut -d' ' -f1
    else
        echo "Error: neither 'shasum' nor 'sha256sum' is available; install one of them." >&2
        exit 1
    fi
}

# One Compose project per checkout and per git worktree, so runs in different checkouts never
# share containers, volumes or networks.
project_hash=$(printf '%s' "$repo_root" | sha256_hex | cut -c1-8)
project="mgmt-app-e2e-${project_hash}"

# Host-browser mode (--up --host): the published ports for Playwright on the host. Gitignored.
HOST_ENV_FILE=test-results/e2e-host.env

usage() {
    echo "Usage: $0 [--rebuild] [--clean] [--ui] [-- <playwright-args>]"
    echo "       $0 --up [--host] | --exec -- <command...> | --down | --prune | --print-project-name | --help"
    echo "       $0 --host-run [--rebuild] [--clean] [-- <playwright-args>] | --host-exec -- <command...>"
    echo ""
    echo "Run the Playwright e2e suite fully in Docker: Postgres, SeaweedFS, the app server, Playwright"
    echo "and Chromium. Only the UI port of a session or --ui run is published, on 127.0.0.1 at a free"
    echo "port (--up --host also publishes the app, Postgres and SeaweedFS for Playwright on this machine)."
    echo "Containers are removed when the run ends; volumes are kept, so the next run is warm."
    echo "Results land in test-results/e2e/."
    echo ""
    echo "Options:"
    echo "  --rebuild             Force a fresh 'next build' even when the app sources are unchanged"
    echo "  --clean               Fresh test database, storage, node_modules and build, but KEEP the pnpm"
    echo "                        store, pnpm metadata & corepack cache (fast offline reinstall). Combines"
    echo "                        with a run or --up. Refused while a session is up. Also the fix for a"
    echo "                        broken install."
    echo "  --ui                  Open Playwright UI mode, served from the container. Prints a"
    echo "                        http://127.0.0.1:<port> URL to open in any browser; Ctrl-C stops it."
    echo "  --up                  Start an interactive session (stack + app server) and keep it running."
    echo "                        On a running session, print its status. Runs and --ui then use it."
    echo "  --exec -- <cmd...>    Run a command in the session, e.g. pnpm exec playwright-cli ... Commands run"
    echo "                        in the checkout root; playwright-cli writes to test-results/cli/ unless a"
    echo "                        --filename path says otherwise (relative paths start at the checkout root)."
    echo "  --host                With --up: host-browser mode. Playwright and the browsers run on this machine."
    echo "                        The session publishes the app, Postgres and SeaweedFS on 127.0.0.1 at free"
    echo "                        ports and writes them to $HOST_ENV_FILE. The in-container browser"
    echo "                        cannot reach SeaweedFS then, so plain runs and --ui are refused in it."
    echo "  --host-run            Fresh database and app server, then 'playwright test' on this machine. Uses"
    echo "                        the --host session; without a session it starts one and ends it afterwards."
    echo "                        Runs chromium + a11y (as in Docker) unless the arguments name a --project or --ui."
    echo "                        Host-only projects: webkit, firefox, chrome, msedge; --project='*' runs all."
    echo "                        A second host run in this checkout waits for the first."
    echo "  --host-exec -- <cmd>  In a --host session: run a command on this machine with $HOST_ENV_FILE"
    echo "                        loaded, e.g. pnpm exec playwright-cli (its session is named after the project)."
    echo "  --down                Remove this checkout's e2e containers + network, KEEP all volumes. Ends a"
    echo "                        session. Then exits."
    echo "  --prune               Remove containers, networks and ALL volumes of this checkout, including the"
    echo "                        pnpm store, pnpm metadata & corepack cache. The runner image is kept."
    echo "                        Then exits."
    echo "  --print-project-name  Print this checkout's Compose project name and exit"
    echo "  --help                Show this help message"
    echo ""
    echo "Examples:"
    echo "  $0                                        # Run the whole suite"
    echo "  $0 -- tests/signin.spec.ts                # Run one spec"
    echo "  $0 -- -g 'creates a study' --trace on     # Filter by title, keep traces of passing tests"
    echo "  $0 --clean -- tests/signin.spec.ts        # Fresh state, then one spec"
    echo "  $0 --ui -- tests/study-flow.spec.ts       # UI mode, filtered to one spec"
    echo "  $0 --up                                   # Start a session"
    echo "  $0 --exec -- pnpm exec playwright-cli open http://localhost:4100/account/signin"
    echo "  $0 --down                                 # End the session"
    echo "  $0 --host-run                             # Whole suite (chromium + a11y) on this machine"
    echo "  $0 --host-run -- --project='*'            # Whole suite in every host browser"
    echo "  $0 --up --host                            # Start a session for browsers on this machine"
    echo "  $0 --host-run -- --project=webkit --headed tests/signin.spec.ts"
    echo "  $0 --host-run -- --ui                     # Playwright UI on this machine, every host browser"
    echo "  $0 --host-exec -- pnpm exec playwright-cli open --browser webkit --headed <app url>"
    echo ""
    echo "Host-browser mode needs, once on this machine: pnpm install, then"
    echo "      pnpm exec playwright install chromium webkit firefox (global setup always uses Chromium)"
    echo "      pnpm exec playwright-cli install-browser webkit (for playwright-cli; any other browser too)"
    echo "      chrome and msedge use the installed Google Chrome and Microsoft Edge."
    echo ""
    echo "Note: the app is rebuilt only when its sources changed (a fingerprint over src/, public/, types/,"
    echo "      the Next/Sentry/TS configs, the lockfile and the runner image). Editing only specs never"
    echo "      rebuilds."
    echo "      Values in host .env files are not part of the fingerprint: use --rebuild after changing them."
    echo ""
    echo "      Every run starts on a fresh test database: a copy of a migrated and seeded template, which"
    echo "      is rebuilt when src/database/migrations, src/database/seeds or bin/seed-environment.ts change."
    echo "      In a session this restarts the app server on each run. After changing seed helpers, --clean."
    echo ""
    echo "      Workers: half of the CPUs that Docker reports (docker info), at least 2. The stack's single app"
    echo "      server limits throughput, so more workers only slow each test. When other e2e or unit test runs"
    echo "      are active at the start, this run takes an even share of that half (at least 2)."
    echo "      PLAYWRIGHT_WORKERS=<n> overrides it."
    echo ""
    echo "      Timeouts are the CI ones (60s per test, 30s per action and expect), because the Docker"
    echo "      host's CPUs are shared with every other stack."
    echo ""
    echo "      Each run rebuilds the e2e-runner image from Dockerfile.dev first (about a second when"
    echo "      nothing changed). Chromium lives in image layers keyed on the locked Playwright versions."
    echo ""
    echo "      A session stops by itself after E2E_TTL seconds (default 7200 = 2 h). After a host"
    echo "      'pnpm install' or a Dockerfile.dev change, restart it: --down, then --up. A one-shot"
    echo "      --ui run has no TTL: its stack ends with Ctrl-C."
    exit "${1:-0}"
}

rebuild=false
clean=false
host=false
action=run
extra_args=()

set_action() {
    if [ "$action" != run ]; then
        echo "Error: --$action and --$1 cannot be combined." >&2
        usage 1
    fi
    action=$1
}

while [ $# -gt 0 ]; do
    case $1 in
        --rebuild) rebuild=true ;;
        --clean) clean=true ;;
        --ui) set_action ui ;;
        --up) set_action up ;;
        --host) host=true ;;
        --host-run) set_action host-run ;;
        --host-exec) set_action host-exec ;;
        --exec) set_action exec ;;
        --down) set_action down ;;
        --prune) set_action prune ;;
        --print-project-name)
            echo "$project"
            exit 0
            ;;
        --help | -h) usage ;;
        --)
            shift
            # An array keeps spaced arguments such as -g 'two words' intact.
            extra_args=("$@")
            break
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage 1
            ;;
    esac
    shift
done

if { [ "$action" = exec ] || [ "$action" = host-exec ]; } && [ ${#extra_args[@]} -eq 0 ]; then
    echo "Error: --$action needs a command after --." >&2
    usage 1
fi
if [ "$host" = true ] && [ "$action" != up ]; then
    echo "Error: --host only combines with --up." >&2
    usage 1
fi

# Without an explicit project name Compose falls back to the folder name, which is the dev stack's
# project; a teardown with --remove-orphans would then remove the running dev containers.
case $project in
    mgmt-app-e2e-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
    *)
        echo "Error: unexpected Compose project name '$project'." >&2
        exit 1
        ;;
esac

export E2E_RUNNER_IMAGE="${project}-e2e-runner"

compose_files=(-f "$repo_root/docker-compose.e2e.yml")
if [ "$host" = true ]; then compose_files+=(-f "$repo_root/docker-compose.e2e-host.yml"); fi

# --env-file /dev/null keeps a host .env (COMPOSE_* or anything else) out of the interpolation.
compose() {
    docker compose -p "$project" "${compose_files[@]}" --env-file /dev/null "$@"
}

running_container() {
    docker ps -q \
        --filter "label=com.docker.compose.project=$project" \
        --filter "label=com.docker.compose.service=$1" 2>/dev/null || true
}

if [ "$action" = down ]; then
    echo "Removing e2e containers + network for this checkout (volumes kept)..."
    compose down -t 1 --remove-orphans
    exit 0
fi

if [ "$action" = prune ]; then
    echo "Removing ALL e2e Docker resources for this checkout (the runner image is kept)..."
    compose down -t 1 -v --remove-orphans
    # `down -v` only removes volumes the current compose file still declares.
    leftover=$(docker volume ls -q --filter "name=^${project}_" 2>/dev/null || true)
    if [ -n "$leftover" ]; then
        echo "Removing leftover volumes:"
        echo "$leftover" | sed 's/^/  /'
        echo "$leftover" | xargs docker volume rm >/dev/null 2>&1 || true
    fi
    echo "Done. The next run reinstalls dependencies from the network and builds the app from cold."
    exit 0
fi

# One one-shot run per checkout: its running runner container is the lock. Checked after argument
# parsing so --help and --print-project-name work with Docker stopped. A running session is not a
# lock: runs go through it and are serialized inside the container.
if [ -n "$(running_container e2e-runner)" ]; then
    echo "Error: a ./bin/docker-e2e run is already active for this checkout." >&2
    echo "       Wait for it to finish, or run ./bin/docker-e2e --down if it was killed." >&2
    exit 1
fi
session=$(running_container e2e-session)

# Empty when the port is not published. Never fails: under pipefail, a failed `docker port` in an
# assignment would end the script.
published_port() {
    { docker port "$1" "$2/tcp" 2>/dev/null || true; } | head -n 1 | sed 's/.*://'
}

# Only a session started with --up --host publishes the app port.
host_session=false
if [ -n "$session" ] && [ -n "$(published_port "$session" 4100)" ]; then host_session=true; fi

# --up --host starts Postgres and SeaweedFS with host ports before the session container. Another
# run in that window would recreate them without the ports and break the starting session.
if [ -z "$session" ] && [ -n "$(published_port "$(running_container db-e2e)" 5432)" ]; then
    echo "Error: a host-browser session is starting for this checkout, or its session container stopped." >&2
    echo "       Wait for it, or run ./bin/docker-e2e --down if it was killed." >&2
    exit 1
fi

if [ "$action" = exec ] && [ -z "$session" ]; then
    echo "Error: no session is running for this checkout. Start one with ./bin/docker-e2e --up." >&2
    exit 1
fi
case $action in
    host-run | host-exec)
        # Like a plain run without a session: a one-shot --host-run brings its own session and ends it.
        if [ -z "$session" ] && [ "$action" = host-run ]; then
            echo "No session is running for this checkout; starting a host-browser session for this run."
            self="$repo_root/bin/docker-e2e"
            export E2E_ONESHOT=1
            trap '"$self" --down >/dev/null 2>&1 || true' EXIT
            trap 'exit 130' INT
            trap 'exit 143' TERM
            up_flags=()
            if [ "$clean" = true ]; then up_flags+=(--clean); fi
            if [ "$rebuild" = true ]; then up_flags+=(--rebuild); fi
            "$self" --up --host ${up_flags[@]+"${up_flags[@]}"}
            status=0
            "$self" --host-run -- ${extra_args[@]+"${extra_args[@]}"} || status=$?
            exit "$status"
        fi
        if [ -z "$session" ]; then
            echo "Error: no session is running for this checkout. Start one with ./bin/docker-e2e --up --host." >&2
            exit 1
        fi
        if [ "$host_session" = false ]; then
            echo "Error: the session of this checkout is not in host-browser mode." >&2
            echo "       End it with ./bin/docker-e2e --down, then start one with ./bin/docker-e2e --up --host." >&2
            exit 1
        fi
        if [ "${E2E_ONESHOT:-}" != 1 ] &&
            docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$session" | grep -x 'E2E_ONESHOT=1' >/dev/null; then
            echo "Error: a one-shot ./bin/docker-e2e --host-run is active for this checkout; its session ends with it." >&2
            echo "       Wait for it to finish, or use ./bin/docker-e2e --up --host for several runs." >&2
            exit 1
        fi
        ;;
esac
# A run during the session's own install and build would race it.
if [ -n "$session" ] && [ "$action" != exec ] &&
    [ "$(docker inspect -f '{{.State.Health.Status}}' "$session" 2>/dev/null)" != healthy ]; then
    echo "The session of this checkout is still starting (installing, migrating or building)." >&2
    echo "Wait for its ./bin/docker-e2e --up to finish, then retry." >&2
    exit 1
fi
if [ "$clean" = true ] && [ -n "$session" ]; then
    echo "Error: --clean would delete volumes under the running session. Run ./bin/docker-e2e --down first." >&2
    exit 1
fi
# The session's presigned S3 URLs point at a host port, which a browser in the container cannot reach.
if [ "$host_session" = true ]; then
    case $action in
        run)
            echo "Error: the session of this checkout is in host-browser mode, so the container's browser" >&2
            echo "       cannot reach its S3 storage. Use ./bin/docker-e2e --host-run -- <playwright-args>," >&2
            echo "       or end the session with ./bin/docker-e2e --down and run again." >&2
            exit 1
            ;;
        ui)
            echo "Error: the session of this checkout is in host-browser mode, so the container's browser" >&2
            echo "       cannot reach its S3 storage. Use ./bin/docker-e2e --host-run -- --ui for Playwright UI" >&2
            echo "       mode on this machine, or end the session with ./bin/docker-e2e --down." >&2
            exit 1
            ;;
        exec)
            case " ${extra_args[*]} " in
                *playwright*)
                    echo "Warning: this session is in host-browser mode; a browser in the container cannot load" >&2
                    echo "         uploads or downloads. Use ./bin/docker-e2e --host-exec -- <cmd> for browsers." >&2
                    ;;
            esac
            ;;
    esac
fi

# The TTL stops a forgotten stack. A one-shot UI run can stay open for longer and ends its stack at
# Ctrl-C, so its database and storage get none (timeout 0 is no limit).
E2E_INFRA_TTL=${E2E_TTL:-7200}
if [ "$action" = ui ] && [ -z "$session" ]; then E2E_INFRA_TTL=0; fi
export E2E_INFRA_TTL

tty_flag=(-T)
if [ -t 0 ] && [ -t 1 ]; then tty_flag=(); fi

if [ "$action" = exec ]; then
    exec docker compose -p "$project" -f "$repo_root/docker-compose.e2e.yml" --env-file /dev/null \
        exec ${tty_flag[@]+"${tty_flag[@]}"} e2e-session "${extra_args[@]}"
fi

ui_port() {
    published_port "$1" 9323
}

session_status() {
    local deadline minutes_left app_port
    deadline=$(compose exec -T e2e-session cat /tmp/e2e-session.deadline 2>/dev/null || echo 0)
    minutes_left=$(((deadline - $(date +%s)) / 60))
    app_port=$(published_port "$session" 4100)
    echo "Session is up for this checkout (project $project); it stops by itself in ${minutes_left} min."
    if [ -n "$app_port" ]; then
        echo "  Mode:        host browsers (Playwright and the browsers run on this machine)"
        echo "  App:         http://localhost:$app_port/account/signin"
        echo "  Run specs:   ./bin/docker-e2e --host-run -- [--project=webkit] [--headed] <playwright-args>"
        echo "  UI mode:     ./bin/docker-e2e --host-run -- --ui"
        echo "  Commands:    ./bin/docker-e2e --host-exec -- pnpm exec playwright-cli open --browser webkit --headed http://localhost:$app_port/account/signin"
        echo "  Host env:    $HOST_ENV_FILE"
        echo "  In session:  ./bin/docker-e2e --exec -- <cmd...>"
    else
        echo "  Run specs:   ./bin/docker-e2e -- <playwright-args>"
        echo "  Commands:    ./bin/docker-e2e --exec -- <cmd...>"
        echo "  UI mode:     ./bin/docker-e2e --ui   (then open http://127.0.0.1:$(ui_port "$session"))"
    fi
    echo "  End it:      ./bin/docker-e2e --down"
}

# Rewritten before every host command, so it always has the ports of the running session.
write_host_env() {
    local app_port db_port s3_port
    app_port=$(published_port "$session" 4100)
    db_port=$(published_port "$(running_container db-e2e)" 5432)
    s3_port=$(published_port "$(running_container seaweedfs-e2e)" 8333)
    if [ -z "$app_port" ] || [ -z "$db_port" ] || [ -z "$s3_port" ]; then
        echo "Error: the host-browser session is missing a published port (app '$app_port', Postgres '$db_port'," >&2
        echo "       SeaweedFS '$s3_port'). Restart it: ./bin/docker-e2e --down, then ./bin/docker-e2e --up --host." >&2
        exit 1
    fi
    mkdir -p "$(dirname "$HOST_ENV_FILE")"
    {
        echo "# Written by ./bin/docker-e2e for the host-browser session of $project."
        echo "E2E_BASE_URL=http://localhost:$app_port"
        echo "E2E_EXTERNAL_SERVER=1"
        echo "DATABASE_URL=postgres://si:si@localhost:$db_port/si_e2e"
        echo "S3_ENDPOINT=http://localhost:$s3_port"
        echo "S3_BROWSER_ENDPOINT=http://localhost:$s3_port"
        echo "AWS_ACCESS_KEY_ID=si-local-s3"
        echo "AWS_SECRET_ACCESS_KEY=si-local-s3"
        echo "BUCKET_NAME=mgmt-app-local"
        echo "AWS_REGION=us-east-1"
        echo "E2E_FAKE_CLERK=1"
        echo "E2E_CI_TIMEOUTS=1"
        echo "PLAYWRIGHT_CLI_SESSION=$project"
        grep -v '^#' bin/lib/e2e-blank.env
    } >"$HOST_ENV_FILE"
}

# In a subshell, so the env file never leaks into this script's own docker calls.
run_with_host_env() {
    (
        set -a
        # shellcheck source=/dev/null
        . "./$HOST_ENV_FILE"
        set +a
        exec "$@"
    )
}

if [ "$action" = host-exec ]; then
    write_host_env
    status=0
    run_with_host_env "${extra_args[@]}" || status=$?
    exit "$status"
fi

if [ "$action" = up ] && [ -n "$session" ]; then
    if [ "$host" = true ] && [ "$host_session" = false ]; then
        echo "Error: the session of this checkout is not in host-browser mode." >&2
        echo "       End it with ./bin/docker-e2e --down, then start one with ./bin/docker-e2e --up --host." >&2
        exit 1
    fi
    if [ "$host_session" = true ]; then write_host_env; fi
    session_status
    exit 0
fi

# Read from the lockfile, so no host node_modules is needed.
importer_version() {
    awk -v key="      '$1':" '
        $0 == key { found = 1; next }
        found && $1 == "version:" { sub(/\(.*/, "", $2); print $2; exit }
    ' pnpm-lock.yaml
}

# The package appears twice: in `packages:` (no dependencies) and in `snapshots:`.
snapshot_dependency_version() {
    awk -v key="  '$1':" -v dep="$2:" '
        $0 == key { found = 1; next }
        found && /^  [^ ]/ { found = 0 }
        found && $1 == dep { print $2; exit }
    ' pnpm-lock.yaml
}

# Layers + config, not the image ID: with the containerd image store the ID changes on every
# fully cached build, which would rebuild the app on every run.
image_key() {
    docker image inspect -f '{{json .RootFS.Layers}}{{json .Config}}' "$1" | sha256_hex
}

# Computed on the host, because git inside the container breaks for worktrees (their .git file
# points at a host path). Covers committed, staged, unstaged and untracked app inputs.
app_fingerprint() {
    local image_id=$1
    local inputs=(src public types next.config.ts sentry.server.config.ts sentry.edge.config.ts package.json
        pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json postcss.config.mjs)
    local exclude=':(exclude)*.test.*'
    {
        git ls-files -s -- "${inputs[@]}" "$exclude"
        git diff HEAD -- "${inputs[@]}" "$exclude"
        git ls-files -o --exclude-standard -z -- "${inputs[@]}" "$exclude" |
            while IFS= read -r -d '' file; do
                printf '%s %s\n' "$(git hash-object -- "$file")" "$file"
            done
        echo "$image_id"
    } | sha256_hex
}

E2E_REBUILD=
if [ "$rebuild" = true ]; then E2E_REBUILD=1; fi
export E2E_REBUILD

# Waits until the UI answers on the published loopback port, then prints its URL.
print_ui_url() {
    local service=$1 container port i
    for i in $(seq 1 1800); do
        container=$(running_container "$service")
        port=
        if [ -n "$container" ]; then port=$(ui_port "$container"); fi
        if [ -n "$port" ] && curl -s -o /dev/null --max-time 2 "http://127.0.0.1:$port"; then
            echo ""
            echo "[docker-e2e] Playwright UI: open http://127.0.0.1:$port  (Ctrl-C stops it)"
            echo ""
            return 0
        fi
        sleep 1
    done
}

# All stacks share the Docker VM's CPU and memory, so a failure next to another busy stack may be
# timing-related. Listed at the start, and as the last lines with every stack seen during the run:
# a stack started after this run did is caught only by polling. Never blocks a run or changes the exit code.
stack_log=$(mktemp "${TMPDIR:-/tmp}/docker-e2e-stacks.XXXXXX")
stack_watcher=
trap 'rm -f "$stack_log"' EXIT

# A session is busy while a run prepares (the runner script) or tests (Playwright); docker-init
# keeps the session's startup arguments. docker top works on any Docker host.
session_busy() {
    local procs
    procs=$(docker top "$1" 2>/dev/null || true)
    # awk reads all input: an early-exiting grep -q would SIGPIPE docker top and, under pipefail,
    # report an idle session.
    awk '!/docker-init/ && /e2e-runner\.sh|@playwright\/test\/cli\.js test/ { busy = 1 } END { exit !busy }' <<<"$procs"
}

# One line per other e2e project, by its session container if it has one. A one-shot run starts its
# database first, so it shows up here about a second after its launcher started.
list_other_stacks() {
    local rows proj dir session service
    rows=$(docker ps --format '{{.ID}}|{{.Label "com.docker.compose.project"}}|{{.Label "com.docker.compose.service"}}|{{.Label "com.docker.compose.project.working_dir"}}' 2>/dev/null || true)
    while IFS='|' read -r proj dir session; do
        [ -n "$proj" ] || continue
        if [ -z "$session" ]; then
            echo "WARNING  another e2e run: $dir ($proj)"
        elif session_busy "$session"; then
            echo "WARNING  another e2e run (in a session): $dir ($proj)"
        else
            echo "info     an e2e session, idle: $dir ($proj)"
        fi
    done < <(awk -F'|' -v self="$project" '
        $2 ~ /^mgmt-app-e2e-/ && $2 != self {
            if (!($2 in dir)) { dir[$2] = $4; order[++n] = $2 }
            if ($3 == "e2e-session") session[$2] = $1
        }
        END { for (i = 1; i <= n; i++) print order[i] "|" dir[order[i]] "|" session[order[i]] }
    ' <<<"$rows")
    while IFS='|' read -r _ proj service dir; do
        case "$proj|$service" in
            mgmt-app-test-*"|test-runner")
                echo "WARNING  unit tests (./bin/docker-test): $dir ($proj)" ;;
        esac
        if [ "$service" = mgmnt-app ]; then echo "info     dev stack (docker compose up): $dir"; fi
    done <<<"$rows"
}

print_stack_notice() {
    [ -s "$stack_log" ] || return 0
    echo ""
    echo "################################################################################"
    echo "[docker-e2e] NOTICE: other Docker stacks were running $1"
    LC_ALL=C sort -u "$stack_log" | sed 's/^/  /'
    echo "  They share the Docker host's CPU and memory, so a timeout may come from load."
    echo "  Before debugging one, rerun it alone: ./bin/docker-e2e -- <spec> --repeat-each 5"
    echo "  (CLAUDE.md, \"Timeouts under Docker load\"). Failures other than timeouts are real."
    echo "################################################################################"
    echo ""
}

watch_other_stacks() {
    (while :; do
        list_other_stacks >>"$stack_log"
        sleep 10
    done) &
    stack_watcher=$!
}

finish_stack_notice() {
    if [ -n "$stack_watcher" ]; then
        pkill -P "$stack_watcher" 2>/dev/null || true
        kill "$stack_watcher" 2>/dev/null || true
        wait "$stack_watcher" 2>/dev/null || true
        stack_watcher=
    fi
    list_other_stacks >>"$stack_log"
    print_stack_notice "during this run"
    rm -f "$stack_log"
}

list_other_stacks >"$stack_log"
print_stack_notice "when this run started"

# Half the Docker CPUs, at least 2: one app server per stack caps throughput at about that, and
# more workers only slow each test. Other e2e and unit test runs counted right before the start
# split that half; runs that start later are not seen, and a run never shrinks once started.
split_workers() {
    [ -z "${PLAYWRIGHT_WORKERS:-}" ] || return 0
    local current other_runs docker_cpus
    current=$(list_other_stacks)
    printf '%s\n' "$current" >>"$stack_log"
    other_runs=$(grep -c '^WARNING' <<<"$current" || true)
    docker_cpus=$(docker info --format '{{.NCPU}}' 2>/dev/null || true)
    [ "${docker_cpus:-0}" -gt 0 ] 2>/dev/null || return 0
    PLAYWRIGHT_WORKERS=$((docker_cpus / 2 / (${other_runs:-0} + 1)))
    if [ "$PLAYWRIGHT_WORKERS" -lt 2 ]; then PLAYWRIGHT_WORKERS=2; fi
    export PLAYWRIGHT_WORKERS
    if [ "${other_runs:-0}" -gt 0 ]; then
        echo "[docker-e2e] $other_runs other e2e or unit test run(s) active: using $PLAYWRIGHT_WORKERS workers on $docker_cpus CPUs (set PLAYWRIGHT_WORKERS to override)"
    else
        echo "[docker-e2e] using $PLAYWRIGHT_WORKERS workers, half of the $docker_cpus CPUs Docker reports (set PLAYWRIGHT_WORKERS to override)"
    fi
}

ui_url_printer=
stop_ui_url_printer() {
    if [ -n "$ui_url_printer" ]; then kill "$ui_url_printer" 2>/dev/null || true; fi
}

# Without a --project, Playwright would run every host browser project, so default to the projects of
# a Docker run. UI mode lists them all instead.
names_project_or_ui() {
    local arg
    for arg in ${extra_args[@]+"${extra_args[@]}"}; do
        case $arg in
            --project | --project=* | --ui | --ui=* | --ui-*) return 0 ;;
        esac
    done
    return 1
}

holder=
hold_dir=
release_host_lock() {
    if [ -n "$holder" ]; then
        exec 7>&-
        wait "$holder" 2>/dev/null || true
        holder=
    fi
    if [ -n "$hold_dir" ]; then
        rm -rf "$hold_dir"
        hold_dir=
    fi
}

if [ "$action" = host-run ]; then
    write_host_env
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'release_host_lock; finish_stack_notice' EXIT
    watch_other_stacks
    # The same preparation as a session run; only Playwright moves to the host. The runner holds the
    # session's Playwright lock until its stdin (fd 7) closes, so a second run waits.
    E2E_APP_FINGERPRINT=$(app_fingerprint "$(image_key "$(docker inspect -f '{{.Image}}' "$session")")")
    echo "Preparing the session of this checkout (project $project)..."
    hold_dir=$(mktemp -d "${TMPDIR:-/tmp}/docker-e2e-hold.XXXXXX")
    mkfifo "$hold_dir/in" "$hold_dir/out"
    compose exec -T -e E2E_APP_FINGERPRINT="$E2E_APP_FINGERPRINT" -e E2E_REBUILD="$E2E_REBUILD" \
        e2e-session bin/lib/e2e-runner.sh --prepare -- hold \
        <"$hold_dir/in" >"$hold_dir/out" &
    holder=$!
    exec 7>"$hold_dir/in"
    locked=false
    while IFS= read -r line; do
        if [ "$line" = '[docker-e2e] lock held for the host run' ]; then
            locked=true
            break
        fi
        printf '%s\n' "$line"
    done <"$hold_dir/out"
    if [ "$locked" = false ]; then
        status=0
        wait "$holder" || status=$?
        holder=
        if [ "$status" -eq 0 ]; then status=1; fi
        exit "$status"
    fi
    split_workers
    playwright_args=(${extra_args[@]+"${extra_args[@]}"})
    if ! names_project_or_ui; then
        playwright_args=(--project=chromium --project=a11y ${playwright_args[@]+"${playwright_args[@]}"})
    fi
    echo "Running Playwright on this machine against the session (project $project)..."
    status=0
    run_with_host_env pnpm exec playwright test ${playwright_args[@]+"${playwright_args[@]}"} || status=$?
    exit "$status"
fi

if [ -n "$session" ]; then
    # Runs inside the session. The image is not rebuilt here; the fingerprint uses the image the
    # session runs, so app edits during the session still trigger a rebuild + server restart.
    E2E_APP_FINGERPRINT=$(app_fingerprint "$(image_key "$(docker inspect -f '{{.Image}}' "$session")")")
    run_id="$(date +%s)-$$"
    # `docker compose exec` without a TTY does not pass Ctrl-C on, so stop this run's own
    # processes inside the container. Other runs waiting for the lock are left alone.
    stop_session_run() {
        stop_ui_url_printer
        compose exec -T e2e-session sh -c \
            'f=/tmp/e2e-run-$1.pid; [ -f "$f" ] || exit 0; p=$(cat "$f"); pkill -INT -P "$p"; kill -INT "$p"; rm -f "$f"' \
            _ "$run_id" >/dev/null 2>&1 || true
    }
    trap 'stop_session_run; exit 130' INT
    trap 'stop_session_run; exit 143' TERM
    trap 'stop_ui_url_printer; finish_stack_notice' EXIT
    watch_other_stacks

    command=test
    if [ "$action" = ui ]; then
        command=ui
        print_ui_url e2e-session &
        ui_url_printer=$!
    fi
    echo "Running in the session of this checkout (project $project)..."
    split_workers
    status=0
    compose exec ${tty_flag[@]+"${tty_flag[@]}"} \
        -e E2E_APP_FINGERPRINT="$E2E_APP_FINGERPRINT" -e E2E_REBUILD="$E2E_REBUILD" -e E2E_RUN_ID="$run_id" \
        ${PLAYWRIGHT_WORKERS:+-e PLAYWRIGHT_WORKERS="$PLAYWRIGHT_WORKERS"} \
        e2e-session bin/lib/e2e-runner.sh --prepare -- "$command" ${extra_args[@]+"${extra_args[@]}"} || status=$?
    compose exec -T e2e-session rm -f "/tmp/e2e-run-${run_id}.pid" >/dev/null 2>&1 || true
    exit "$status"
fi

PNPM_PACKAGE_MANAGER=$(sed -nE 's/^ *"packageManager": *"([^"]+)".*/\1/p' package.json)
PLAYWRIGHT_VERSION=$(importer_version '@playwright/test')
playwright_cli_version=$(importer_version '@playwright/cli')
PLAYWRIGHT_CLI_CORE_VERSION=
if [ -n "$playwright_cli_version" ]; then
    PLAYWRIGHT_CLI_CORE_VERSION=$(snapshot_dependency_version "@playwright/cli@${playwright_cli_version}" playwright-core)
fi
if [ -z "$PNPM_PACKAGE_MANAGER" ] || [ -z "$PLAYWRIGHT_VERSION" ] || [ -z "$PLAYWRIGHT_CLI_CORE_VERSION" ]; then
    echo "Error: could not read packageManager from package.json, or @playwright/test and" >&2
    echo "       @playwright/cli's playwright-core from pnpm-lock.yaml." >&2
    exit 1
fi
export PNPM_PACKAGE_MANAGER PLAYWRIGHT_VERSION PLAYWRIGHT_CLI_CORE_VERSION

teardown() {
    stop_ui_url_printer
    compose down -t 1 --remove-orphans >/dev/null 2>&1 || true
    finish_stack_notice
}

# Starting the database and storage first makes this run visible to other launchers within a
# second, and they start up while the image builds. --clean removes their volumes first.
if [ "$clean" = false ] && [ "$action" != up ]; then
    trap teardown EXIT
    compose up -d --quiet-pull db-e2e seaweedfs-e2e >/dev/null 2>&1 || true
fi

echo "Building the e2e-runner image..."
compose build --quiet e2e-runner

if [ "$clean" = true ]; then
    echo "Cleaning the test database, storage, build and node_modules (pnpm store, pnpm metadata + corepack cache kept)..."
    compose down -t 1 --remove-orphans
    docker volume rm "${project}_pgdata-e2e" "${project}_seaweedfs-data-e2e" "${project}_next_e2e" >/dev/null 2>&1 || true
    compose run -T --rm --no-deps --entrypoint sh e2e-runner \
        -c 'find /app/node_modules -mindepth 1 -maxdepth 1 ! -name .pnpm-store ! -name .pnpm-cache ! -name .corepack -exec find {} -depth -delete \;' || true
fi

E2E_APP_FINGERPRINT=$(app_fingerprint "$(image_key "$E2E_RUNNER_IMAGE")")
export E2E_APP_FINGERPRINT

if [ "$action" = up ]; then
    echo "Starting an e2e session for this checkout (project $project)..."
    # A session that ended by its TTL leaves a stopped container whose /tmp still has the old ready
    # file; restarting it would report ready before the new setup is done.
    compose rm -f -s e2e-session >/dev/null 2>&1 || true
    if [ "$host" = true ]; then
        # The session's server signs S3 URLs for the host browser, so it needs SeaweedFS's host port
        # before it starts.
        echo "Host-browser mode: publishing the app, Postgres and SeaweedFS on 127.0.0.1..."
        compose up -d db-e2e seaweedfs-e2e
        s3_port=$(published_port "$(running_container seaweedfs-e2e)" 8333)
        if [ -z "$s3_port" ]; then
            echo "Error: SeaweedFS has no published port. Clean up with --down and retry." >&2
            exit 1
        fi
        export E2E_HOST_S3_URL="http://localhost:$s3_port"
    fi
    compose up -d e2e-session
    session=$(compose ps -a -q e2e-session)
    # Not through compose(): `$!` of a backgrounded function is its subshell, and killing that
    # would leave `docker compose logs -f` running and holding stdout open.
    docker compose -p "$project" -f "$repo_root/docker-compose.e2e.yml" --env-file /dev/null \
        logs -f --no-log-prefix e2e-session &
    log_follower=$!
    # Healthy once the runner wrote its ready file (deps, DB, build and server done).
    state=
    while :; do
        state=$(docker inspect -f '{{.State.Status}} {{.State.Health.Status}}' "$session" 2>/dev/null || echo gone)
        case $state in
            "running starting") sleep 2 ;;
            *) break ;;
        esac
    done
    kill "$log_follower" 2>/dev/null || true
    if [ "$state" != "running healthy" ]; then
        echo "Error: the session did not become ready ($state); see the output above. Clean up with --down." >&2
        exit 1
    fi
    if [ "$host" = true ]; then write_host_env; fi
    echo ""
    session_status
    exit 0
fi

trap teardown EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
watch_other_stacks

split_workers
status=0
if [ "$action" = ui ]; then
    echo "Starting Playwright UI mode in Docker (project $project)..."
    print_ui_url e2e-runner &
    ui_url_printer=$!
    # Plain `run` publishes no ports; --service-ports publishes the loopback-only UI port.
    compose run ${tty_flag[@]+"${tty_flag[@]}"} --rm --service-ports e2e-runner \
        ui ${extra_args[@]+"${extra_args[@]}"} || status=$?
else
    echo "Running e2e tests in Docker (project $project)..."
    compose run ${tty_flag[@]+"${tty_flag[@]}"} --rm e2e-runner \
        test ${extra_args[@]+"${extra_args[@]}"} || status=$?
fi
exit "$status"
