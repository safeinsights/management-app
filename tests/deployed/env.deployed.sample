# Copy to the repository root as .env.deployed (gitignored). Same variable names as qa-review's
# config/environments.ts, so one file serves both tools. Per role (ADMIN, RESEARCHER, REVIEWER) and
# environment (QA, STAGING, PRODUCTION, DEMO); PR previews use the QA accounts.

QA_BASE_URL=https://app.qa.safeinsights.org
STAGING_BASE_URL=
PRODUCTION_BASE_URL=
DEMO_BASE_URL=

# One block per role and environment. Either an MFA seed (base32 TOTP) or a fixed code.
ADMIN_EMAIL_QA=
ADMIN_PASSWORD_QA=
ADMIN_MFA_SEED_QA=
ADMIN_MFA_CODE_QA=
ADMIN_RESULTS_PRIVATE_KEY_QA=

RESEARCHER_EMAIL_QA=
RESEARCHER_PASSWORD_QA=
RESEARCHER_MFA_SEED_QA=
RESEARCHER_MFA_CODE_QA=
RESEARCHER_RESULTS_PRIVATE_KEY_QA="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

REVIEWER_EMAIL_QA=
REVIEWER_PASSWORD_QA=
REVIEWER_MFA_SEED_QA=
REVIEWER_MFA_CODE_QA=
REVIEWER_RESULTS_PRIVATE_KEY_QA="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Optional knobs read by the specs.
# E2E_EXPECTED_RELEASE=        the tag or short SHA the about page must show
# E2E_LAB_SLUG=openstax-lab    the lab the writes go through
# E2E_ENCLAVE_SLUG=openstax    the Data Partner org reviewing them
# E2E_DATA_PARTNER_NAME=Openstax
# E2E_SLA_LAB_SLUG=agreements  a lab that is not a Test Lab (study-agreement.spec)
# E2E_SLA_LAB_NAME=Agreements Lab
# E2E_CODER=0                  leave the IDE spec out
# E2E_SMOKE_MUTATE=1           allow the mutating smoke checks on production/demo
