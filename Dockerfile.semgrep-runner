FROM node:24-slim AS builder
WORKDIR /repo
RUN corepack enable
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY services/semgrep-runner/package.json ./services/semgrep-runner/
RUN pnpm --filter=@safeinsights/semgrep-runner install --frozen-lockfile --prod --ignore-scripts
COPY services/semgrep-runner ./services/semgrep-runner
RUN rm -rf services/semgrep-runner/*.test.ts services/semgrep-runner/fixtures

FROM public.ecr.aws/lambda/nodejs:24
# requirements.txt pins Semgrep and every dependency with hashes; it is the one place the version is set.
# LD_LIBRARY_PATH starts with /var/lang/lib, Node's own OpenSSL, against which Python's ssl module fails to
# load; pip needs it to download.
COPY services/semgrep-runner/requirements.txt /tmp/semgrep-requirements.txt
RUN dnf install -y python3.12 python3.12-pip && dnf clean all \
    && python3.12 -m venv /opt/semgrep \
    && LD_LIBRARY_PATH=/usr/lib64 /opt/semgrep/bin/pip install --no-cache-dir --require-hashes --no-deps \
        -r /tmp/semgrep-requirements.txt \
    && rm /tmp/semgrep-requirements.txt
# Lambda's file system is read only outside /tmp, and Semgrep writes settings, a log and a version cache.
ENV PATH=/opt/semgrep/bin:$PATH \
    HOME=/tmp \
    SEMGREP_SETTINGS_FILE=/tmp/.semgrep/settings.yml \
    SEMGREP_LOG_FILE=/tmp/.semgrep/semgrep.log \
    SEMGREP_VERSION_CACHE_PATH=/tmp/.cache/semgrep_version
# The package's node_modules holds pnpm symlinks into ../../node_modules/.pnpm, as in the editor image.
COPY --from=builder /repo/node_modules ${LAMBDA_TASK_ROOT}/node_modules
COPY --from=builder /repo/services/semgrep-runner/ ${LAMBDA_TASK_ROOT}/services/semgrep-runner/
CMD ["services/semgrep-runner/index.handler"]
